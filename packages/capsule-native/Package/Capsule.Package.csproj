<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Capsule.Package</AssemblyName>
    <RootNamespace>Capsule.Package</RootNamespace>
    <Description>Capsule package loading, manifests, themes and images.</Description>
    <CapsuleAllowNewtonsoft>true</CapsuleAllowNewtonsoft>
    <CapsuleAllowCore>true</CapsuleAllowCore>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Capsule.Core.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.2]" />
    <Compile Include="../../../unity/Packages/com.capsule.package/Runtime/*.cs" Link="Package/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
