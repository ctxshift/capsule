{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "types": ["node", "react"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react"
  },
  "include": ["src/**/*.ts", "src/**/*.mjs"]
}
